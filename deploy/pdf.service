[Unit]
Description=Atelier PDF - replace text in PDFs without moving anything else
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/pdf/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# uvicorn kills a worker that does not answer its health check within 5 s, and
# the check needs the GIL. Saving a large PDF with pikepdf holds the GIL in one
# call: ~8 s for a 270 MB file with uncompressed streams. Hence 120 s.
ExecStart=/srv/pdf/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 10560 \
    --workers 2 \
    --timeout-keep-alive 30 \
    --timeout-worker-healthcheck 120 \
    --proxy-headers --forwarded-allow-ips='127.0.0.1'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# Sessions and renders live under <install>/data and are purged after three
# hours by the application's own cleanup loop.
StandardOutput=append:/var/log/pdf-atelier.log
StandardError=append:/var/log/pdf-atelier.log

[Install]
WantedBy=multi-user.target
